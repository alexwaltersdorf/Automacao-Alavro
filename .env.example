# =========================================================================
# .env.example — COPIE para .env e preencha os valores.
# O .env real NUNCA entra no git nem no Syncthing (já está no .gitignore).
# Segredos devem ser digitados por VOCÊ — nunca commitados.
# =========================================================================

# --- Runtime / paths (em produção, fora do vault sincronizado) -----------
DB_PATH=/opt/laudos-whatsapp/db/laudos.db
PDF_DIR=/opt/laudos-whatsapp/pdfs

# 0 = produção (envia de verdade) | 1 = simulação (default seguro)
DRY_RUN=1

# --- Evolution API (WhatsApp) — instância compartilhada da unidade -------
EVOLUTION_BASE_URL=https://sua-evolution.example.com
EVOLUTION_API_KEY=COLOQUE_SUA_API_KEY
EVOLUTION_INSTANCE=nome-da-instancia-da-unidade

# Legenda padrão (opcional)
# LEGENDA_PADRAO=Olá! Segue o resultado do seu exame.

# --- Webapp (login de operador, usuário único) ---------------------------
WEBAPP_USER=operador
# Hash SHA-256 da senha. Gere com:
#   python -c "import hashlib,getpass;print(hashlib.sha256(getpass.getpass().encode()).hexdigest())"
WEBAPP_PASSWORD_HASH=COLOQUE_O_HASH_SHA256
# Segredo da sessão. Gere com: python -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET=COLOQUE_UM_SEGREDO_ALEATORIO

# --- Plataforma Neomed (coletor) -----------------------------------------
NEOMED_URL=https://app.neomed.tech/sign-in
NEOMED_USER=laudos@totalquality.med.br
NEOMED_PASSWORD=COLOQUE_A_SENHA_DO_NEOMED
# NEOMED_HEADLESS=1   # 0 para abrir o browser (debug)
