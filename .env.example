# =============================================================================
# CREDENCIAIS OFICIAIS DA META (WhatsApp Cloud API)
# =============================================================================
# Todas obtidas no painel: https://developers.facebook.com/apps
# Passo a passo detalhado no README.md

# Token permanente do Usuário do Sistema (Business Settings > Usuários do sistema)
# Permissões necessárias: whatsapp_business_messaging, whatsapp_business_management,
# business_management
WHATSAPP_ACCESS_TOKEN=

# ID do número de telefone comercial (API Setup > "De" > Phone number ID)
WHATSAPP_PHONE_NUMBER_ID=

# ID da conta do WhatsApp Business / WABA (API Setup > WhatsApp Business Account ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Chave secreta do app (App Settings > Basic > App Secret)
# Usada para validar a assinatura X-Hub-Signature-256 dos webhooks
WHATSAPP_APP_SECRET=

# Token de verificação do webhook — você inventa esta string e informa
# o MESMO valor no painel da Meta em Configuration > Webhook > Verify token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=troque-por-uma-string-aleatoria-longa

# Versão da Graph API
WHATSAPP_API_VERSION=v23.0

# =============================================================================
# LIMITES DE ENVIO (throughput)
# =============================================================================
# Mensagens por segundo. A Cloud API suporta 80/s por padrão (até 1000/s sob
# demanda), mas comece baixo para aquecer o número e evitar bloqueio por spam.
SEND_RATE_PER_SECOND=15

# Requisições HTTP simultâneas contra a Graph API
SEND_CONCURRENCY=8

# Limite de destinatários únicos em 24h conforme o seu tier de mensagens da Meta.
# Tiers: 250 (não verificado) | 1000 | 10000 | 100000 | 0 = ilimitado
DAILY_UNIQUE_RECIPIENT_LIMIT=1000

# Intervalo mínimo entre duas mensagens para o MESMO destinatário, em ms.
# A Meta permite 1 mensagem a cada 6 segundos por usuário (erro 131056 acima
# disso). Em disparo normal cada contato recebe uma vez só e isso não pesa;
# o limite protege campanhas simultâneas e reenvios. 0 desliga a proteção.
PER_RECIPIENT_INTERVAL_MS=6000

# Tentativas máximas por mensagem em caso de erro temporário
MAX_RETRIES=4

# Atraso base (ms) do backoff exponencial entre tentativas
RETRY_BASE_DELAY_MS=2000

# =============================================================================
# APLICAÇÃO
# =============================================================================
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/alavro.sqlite
LOG_LEVEL=info

# Chave para proteger a API REST e o painel (envie no header X-API-Key).
# Deixe vazio para desabilitar a autenticação (APENAS em desenvolvimento local).
API_KEY=

# Código do país padrão usado ao normalizar telefones sem DDI (55 = Brasil)
DEFAULT_COUNTRY_CODE=55

# Iniciar o motor de disparo junto com o servidor
AUTO_START_DISPATCHER=true

# Modo simulação: não chama a API da Meta, apenas registra o que seria enviado.
# Use para testar campanhas sem gastar conversas.
DRY_RUN=false
